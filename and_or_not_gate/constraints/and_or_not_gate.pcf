# this is the physical constraint for and_or_not_gate.v

# base LED
set_io led[0] J11
set_io led[1] K11
set_io led[2] G12
set_io led[3] H12
set_io led[4] K14
set_io led[5] J12
set_io led[6] L14
set_io led[7] K12


# io_button
set_io io_button[0] D1
set_io io_button[1] E4
set_io io_button[2] E1
set_io io_button[3] F4
set_io io_button[4] H4
